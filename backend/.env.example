# claude-board 백엔드 설정
# 주의: DB_NAME 은 반드시 claude_board 여야 한다.
# toy 계정은 toy_board 에도 쓰기 권한이 있으므로, 이 값이 틀리면
# 에러 없이 기존 Go 게시판 데이터를 오염시킨다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=claude_board
DB_USER=toy
DB_PASSWORD=toy_password

APP_PORT=8000
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
CORS_ORIGINS=http://localhost:5174
